{
	"_metadata": {
		"version": "3.0",
		"description": "配置文件，定义LaTeX文档的各项参数"
	},

	// ===== TEX section: drives the LaTeX document layout & code rendering =====
	"TEX": {
		"author": "Aiza",
		"subject": "文档主题",

		// 标题页：content 为主标题，note 为副标题/额外说明
		"title": {
			"content": "文档标题",
			"note": "标题页额外内容"
		},

		// 代码块（minted）的样式与字体设置
		"code": {
			"minted_style": "bw",
			"font_family": "Fira Code",
			"font_size": "6pt",
			"line_height": "6pt",
			"tab_size": 4,
			"bg_color": "gray!3"
		},

		// hyperref 超链接 / PDF 书签
		"hyperref": {
			"enable_colorlinks": true,
			"link_color": "blue",
			"file_color": "magenta",
			"url_color": "cyan",
			"numbered_bookmarks": true,
			"open_bookmarks": false
		},

		// 页面尺寸与边距（geometry 包）
		"geometry": {
			"paper_size": "a4paper",
			"left_margin": "1cm",
			"right_margin": "1cm",
			"top_margin": "1cm",
			"bottom_margin": "1.2cm",
			"column_sep": "1cm"
		},

		// 文档级字体与页眉页脚
		"global": {
			"main_font": "Times New Roman",
			"cjk_main_font": "SimSun",
			"page_style": "plain"
		},
	},

	// ===== PROGRAM section: controls source-tree processing =====
	"PROGRAM": {
		// 包含的源文件扩展名（白名单）
		"include_file_types": [".cpp", ".c", ".json", ".tex", ".hpp", ".h", ".py", ".txt"],
		// 排除的 glob 模式（Microsoft.Extensions.FileSystemGlobbing 语法）
		"ignore_patterns": ["*ignore*"]
	},
}
